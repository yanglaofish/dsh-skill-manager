{
  "name": "@yanglaofish/dsh-skill-manager",
  "version": "4.3.2",
  "description": "Skill lifecycle manager: library / workspace / session three-layer skill management for DSH",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanglaofish/dsh-skill-manager.git"
  },
  "homepage": "https://github.com/yanglaofish/dsh-skill-manager",
  "bugs": {
    "url": "https://github.com/yanglaofish/dsh-skill-manager/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-en.md",
    "screenshots.json"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "yaml": "^2.9.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}